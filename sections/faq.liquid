<!-- ── FAQ de Conversión ── -->
<section class="faq full-width" aria-labelledby="faq-heading-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="faq__container">
    
    <!-- Header -->
    <div class="faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="faq-heading-{{ section.id }}" class="faq__title">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="faq__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Accordion Wrapper -->
    {%- if section.blocks.size > 0 -%}
      <div class="faq__accordion">
        {%- for block in section.blocks -%}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-item__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq-item__icon-wrap">
                <svg class="faq-item__icon faq-item__icon--plus" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </summary>
            <div class="faq-item__answer">
              <div class="faq-item__answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .faq {
    background-color: #f8fafc;
    padding: 6rem 1.25rem;
    color: #0f172a;
  }

  .faq__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq__header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .faq__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #06b6d4;
  }

  .faq__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .faq__subtitle {
    margin: 0.5rem 0 0;
    font-size: 1.0625rem;
    color: #4b5563;
    max-width: 580px;
    line-height: 1.6;
  }

  /* Accordion Layout */
  .faq__accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: #06b6d4;
    box-shadow: 0 10px 15px -3px rgba(6, 182, 212, 0.04);
  }

  /* Hide default marker */
  .faq-item__question::-webkit-details-marker {
    display: none;
  }
  .faq-item__question {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    font-weight: 700;
    font-size: 1.0625rem;
    color: #0f172a;
    cursor: pointer;
    user-select: none;
    gap: 1rem;
  }

  .faq-item__question:hover {
    color: #06b6d4;
  }

  .faq-item__icon-wrap {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .faq-item__question:hover .faq-item__icon-wrap {
    background-color: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
  }

  .faq-item[open] .faq-item__icon-wrap {
    transform: rotate(45deg);
    background-color: #06b6d4;
    color: #ffffff;
  }

  .faq-item__icon {
    transition: transform 0.2s ease;
  }

  /* Answer Container */
  .faq-item__answer {
    border-top: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] .faq-item__answer {
    border-color: #f1f5f9;
  }

  .faq-item__answer-inner {
    padding: 1.25rem 1.5rem 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #4b5563;
  }

  .faq-item__answer-inner p {
    margin-bottom: 0.75rem;
  }

  .faq-item__answer-inner p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ de Conversión",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Copete (Eyebrow)",
      "default": "Preguntas Frecuentes"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "Preguntas y Objeciones Comunes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Resolvemos tus dudas de forma transparente para que compres con total tranquilidad."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Pregunta / Respuesta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Por qué garantizamos productos 100% originales?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Trabajamos de la mano con distribuidores oficiales e importadores autorizados. Cada dispositivo de audio y accesorio de carga se despacha en su empaque original sellado de fábrica y con su respectivo número de serie para tu verificación.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ de Conversión",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Por qué garantizamos productos 100% originales?",
            "answer": "<p>Trabajamos directamente con distribuidores oficiales de marcas líderes como JBL, BOSE y Apple. Todos nuestros productos se entregan en su caja original, con sellos de seguridad intactos y número de serie verificable.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Por qué nuestro envío es el más rápido de Colombia?",
            "answer": "<p>Despachamos todos los pedidos en un plazo de 24 horas hábiles desde nuestra bodega principal en Pereira, Risaralda. Esta ubicación central nos permite entregar en ciudades principales en 1 a 2 días hábiles a través de Servientrega y Coordinadora.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo funciona la garantía directa en tienda física?",
            "answer": "<p>A diferencia de otras tiendas virtuales, contamos con sede física. Si tu producto presenta fallas de fábrica dentro de los 12 meses, lo traes o envías a nuestra tienda en Pereira. Nuestro equipo técnico lo revisa directamente sin intermediarios lentos.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "¿Qué pasa si quiero devolver mi producto?",
            "answer": "<p>Cumplimos plenamente con la Ley 1480 de Colombia (Estatuto del Consumidor). Tienes derecho al retracto durante los primeros 5 días hábiles después de recibir el producto, siempre y cuando esté sin usar y en su empaque original cerrado.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
