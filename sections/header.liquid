<header class="header full-width">
  
  <!-- Nivel Superior: Logo, Buscador, Redes y Cuenta/Carrito -->
  <div class="header__top">
    
    <!-- Mobile Menu Toggle -->
    <button type="button" class="header__menu-toggle" aria-label="Abrir menú" aria-controls="mobile-menu-drawer" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    
    <!-- Logo -->
    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if section.settings.logo != blank %}
        {% assign logo_alt = section.settings.logo.alt | default: shop.name | escape %}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: logo_alt, class: 'header__logo-image' }}
      {% else %}
        {{ 'logo-soportech.svg' | inline_asset_content }}
      {% endif %}
    </a>

    <!-- Search Bar -->
    <div class="header__search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <!-- Filtrar para buscar solo productos -->
        <input type="hidden" name="type" value="product">
        
        <input 
          type="search" 
          name="q" 
          value="{{ search.terms | escape }}" 
          placeholder="Buscar productos..." 
          aria-label="Buscar productos"
          class="search-input"
        >
        <button type="submit" class="search-button" aria-label="Buscar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
    </div>

    <!-- Área de Acciones (Redes Sociales + Iconos de Tienda) -->
    <div class="header__actions">
      
      <!-- Redes Sociales -->
      <div class="header__social">
        <a href="https://www.facebook.com/88JMBubble" target="_blank" aria-label="Facebook" class="social-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a href="https://www.instagram.com/88jmbubble/" target="_blank" aria-label="Instagram" class="social-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      </div>

      <!-- Separador visual -->
      <div class="header__separator"></div>

      <!-- Icons: Account & Cart -->
      <div class="header__icons">
        {% if shop.customer_accounts_enabled %}
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            {{ 'icon-account.svg' | inline_asset_content }}
          </shopify-account>
        {% else %}
          <a href="{{ routes.account_url }}" class="header__icon-link">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="header__icon-link cart-link">
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>

    </div>
  </div>

  <!-- Nivel Inferior: Menú de navegación -->
  <div class="header__bottom">
    <nav class="header__menu">
      {% assign active_menu = section.settings.menu | default: 'main-menu' %}
      {% for link in linklists[active_menu].links %}
        <a href="{{ link.url }}" class="header__menu-link">{{ link.title }}</a>
      {% endfor %}
    </nav>
  </div>
</header>

<!-- Cajón de Navegación Móvil (Drawer) -->
<div id="mobile-menu-drawer" class="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer__overlay"></div>
  <div class="mobile-drawer__content">
    <div class="mobile-drawer__header">
      <h2 class="mobile-drawer__title">Menú</h2>
      <button type="button" class="mobile-drawer__close" aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="mobile-drawer__menu">
      {% assign active_menu = section.settings.menu | default: 'main-menu' %}
      {% for link in linklists[active_menu].links %}
        <a href="{{ link.url }}" class="mobile-drawer__link">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <div class="mobile-drawer__social">
      <a href="https://www.facebook.com/88JMBubble" target="_blank" aria-label="Facebook" class="social-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
      </a>
      <a href="https://www.instagram.com/88jmbubble/" target="_blank" aria-label="Instagram" class="social-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </a>
    </div>
  </div>
</div>

{% stylesheet %}
  html {
    overflow-anchor: none;
  }

  [id$="__header"],
  #shopify-section-header,
  .shopify-section:has(.header) {
    position: sticky;
    top: 0;
    z-index: 100;
    overflow-anchor: none;
  }

  .header {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: relative;
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    overflow-anchor: none;
  }

  .header__menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: #111827;
    padding: 0.5rem;
    align-items: center;
    justify-content: center;
  }

  .header__menu-toggle:hover {
    color: #06b6d4;
  }

  .header__menu-toggle svg {
    width: 24px;
    height: 24px;
  }

  /* MOBILE DRAWER STYLES */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    visibility: hidden;
    transition: visibility 0.3s;
  }

  .mobile-drawer.is-open {
    visibility: visible;
  }

  .mobile-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .mobile-drawer.is-open .mobile-drawer__overlay {
    opacity: 1;
  }

  .mobile-drawer__content {
    position: absolute;
    top: 0;
    left: 0;
    width: 80%;
    max-width: 320px;
    height: 100%;
    background-color: #ffffff;
    box-shadow: 4px 0 10px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
  }

  .mobile-drawer.is-open .mobile-drawer__content {
    transform: translateX(0);
  }

  .mobile-drawer__header {
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e5e7eb;
  }

  .mobile-drawer__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .mobile-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    color: #4b5563;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-drawer__close svg {
    width: 24px;
    height: 24px;
  }

  .mobile-drawer__menu {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex-grow: 1;
    overflow-y: auto;
  }

  .mobile-drawer__link {
    text-decoration: none;
    color: #374151;
    font-weight: 600;
    font-size: 1.1rem;
    transition: color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mobile-drawer__link:hover {
    color: #06b6d4;
  }

  .mobile-drawer__social {
    padding: 1.5rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    gap: 1rem;
  }
  
  /* TOP ROW */
  .header__top {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    transition: padding 0.3s cubic-bezier(0.4, 0, 0.2, 1), gap 0.3s ease;
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }
  
  .header__logo svg {
    width: auto;
    height: 3.25rem;
    transition: opacity 0.2s ease, height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .header__logo:hover svg {
    opacity: 0.85;
  }

  .header__logo-image {
    width: auto;
    height: auto;
    max-height: 120px; /* Aumentado para que el logo se muestre a su tamaño original sin ser encogido por el contenedor */
    object-fit: contain;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* SEARCH BAR */
  .header__search {
    flex-grow: 1;
    max-width: 500px;
    margin: 0 auto;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 1;
    visibility: visible;
    max-height: 100px;
  }
  
  .search-form {
    display: flex;
    align-items: center;
    background-color: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 9999px;
    padding: 0.25rem 0.5rem;
    transition: border-color 0.2s ease, background-color 0.2s;
  }

  .search-form:focus-within {
    background-color: #ffffff;
    border-color: #06b6d4;
    box-shadow: 0 0 0 1px #06b6d4;
  }
  
  .search-input {
    flex-grow: 1;
    border: none;
    background: transparent;
    padding: 0.5rem 1rem;
    outline: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: #111827;
  }
  
  .search-input::placeholder {
    color: #6b7280;
  }
  
  .search-button {
    background: none;
    border: none;
    cursor: pointer;
    color: #4b5563;
    display: flex;
    align-items: center;
    padding: 0.5rem;
    border-radius: 50%;
  }
  
  .search-button:hover {
    color: #06b6d4;
  }
  
  .search-button svg {
    width: 20px;
    height: 20px;
  }

  /* ACTIONS AREA (Social APIs + Icons) */
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .header__social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-link {
    color: #6b7280;
    transition: color 0.2s ease;
    display: flex;
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  .social-link:hover {
    color: #06b6d4;
  }

  .header__separator {
    width: 1px;
    height: 24px;
    background-color: #e5e7eb;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header__icons {
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: gap 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .header__icon-link {
    position: relative;
    text-decoration: none;
    color: #111827;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header__icons svg {
    width: 24px;
    height: 24px;
  }
  
  .cart-link .cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: #ef4444;
    color: white;
    font-size: 0.7rem;
    font-weight: bold;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
  }

  /* BOTTOM ROW (Menu) */
  .header__bottom {
    background-color: #f9fafb;
    border-top: 1px solid #f3f4f6;
  }

  .header__menu {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: center; /* Alineación centrada */
    gap: 2rem;
    height: 3.5rem;
    align-items: center;
  }
  
  .header__menu-link {
    text-decoration: none;
    color: #374151;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .header__menu-link:hover {
    color: #06b6d4;
  }

  /* ── Sticky Scrolled State ── */
  .header--scrolled {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
    border-color: #f1f5f9;
  }

  .header--scrolled .header__top {
    padding: 0.5rem 1.5rem;
    gap: 1.5rem;
  }

  .header--scrolled .header__logo-image {
    max-height: 45px;
  }

  .header--scrolled .header__logo svg {
    height: 2.25rem;
  }

  .header--scrolled .header__search {
    opacity: 0;
    visibility: hidden;
    max-width: 0;
    max-height: 0;
    margin: 0;
    padding: 0;
    pointer-events: none;
    overflow: hidden;
  }

  @media (min-width: 769px) {
    .header--scrolled .header__social,
    .header--scrolled .header__separator,
    .header--scrolled .header__icons shopify-account,
    .header--scrolled .header__icons .header__icon-link:not(.cart-link) {
      opacity: 0;
      visibility: hidden;
      width: 0;
      margin: 0;
      padding: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .header--scrolled .header__icons {
      gap: 0;
    }

    /* Move navigation menu right next to the logo */
    .header__bottom {
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .header__menu {
      transition: gap 0.3s ease;
    }

    .header--scrolled .header__bottom {
      position: absolute;
      left: calc(max(0px, 50% - 600px) + 190px); /* Spaced perfectly next to the 45px logo + padding */
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      width: auto;
      height: 100%;
      display: flex;
      align-items: center;
      z-index: 10;
    }

    .header--scrolled .header__menu {
      height: 100%;
      padding: 0;
      gap: 1.5rem;
    }

    .header--scrolled .header__menu-link {
      font-size: 0.875rem;
    }
  }

  /* Responsive Adjustments */
  @media(max-width: 768px) {
    .header__top {
      flex-wrap: wrap;
      padding: 1rem 1.5rem;
      gap: 1rem;
      justify-content: space-between;
    }

    .header__logo {
      order: 1;
      width: 100%;
      display: flex;
      justify-content: center;
      margin-bottom: 0.5rem;
    }

    .header__menu-toggle {
      display: flex;
      order: 2;
    }

    .header__actions {
      order: 3;
      display: flex;
      justify-content: flex-end;
    }
    
    .header__search {
      order: 4;
      width: 100%;
      max-width: 100%;
      margin-top: 0.5rem;
    }

    /* Restablecer layout anterior al hacer scroll en móviles */
    .header--scrolled .header__logo {
      order: 2;
      width: auto;
      display: flex;
      justify-content: flex-start;
      margin-bottom: 0;
    }

    .header--scrolled .header__menu-toggle {
      order: 1;
    }

    .header--scrolled .header__actions {
      order: 3;
      display: flex;
      justify-content: flex-end;
    }

    .header__social, .header__separator {
      display: none; /* Mejor ocultar redes arriba en móviles pequeños para ahorrar espacio */
    }

    .header__bottom {
      display: none; /* En producción los celulares suelen usar un menú hamburguesa */
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.querySelector('.header__menu-toggle');
    const closeBtn = document.querySelector('.mobile-drawer__close');
    const drawer = document.getElementById('mobile-menu-drawer');
    const overlay = document.querySelector('.mobile-drawer__overlay');

    if (toggleBtn && drawer) {
      function openDrawer() {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        toggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      toggleBtn.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (overlay) overlay.addEventListener('click', closeDrawer);
    }

    // Scroll Sticky Header Effect
    const header = document.querySelector('.header');
    if (header) {
      let ticking = false;
      const thresholdDown = 150; // Scroll down threshold to compress header
      const thresholdUp = 20;    // Scroll up threshold to restore header

      function checkScroll() {
        if (window.scrollY > thresholdDown) {
          header.classList.add('header--scrolled');
        } else if (window.scrollY < thresholdUp) {
          header.classList.remove('header--scrolled');
        }
      }

      window.addEventListener('scroll', function() {
        if (!ticking) {
          window.requestAnimationFrame(function() {
            checkScroll();
            ticking = false;
          });
          ticking = true;
        }
      });

      // Initial check in case page loads scrolled down
      checkScroll();
    }
  });
{% endjavascript %}
