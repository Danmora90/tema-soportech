<div class="clickable-banner full-width section-{{ section.id }}" style="
  --padding-top: {{ section.settings.padding_top }}px;
  --padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <a href="{{ section.settings.link | default: '#' }}" class="clickable-banner__link">
    {%- if section.settings.image != blank -%}
      <picture class="clickable-banner__picture">
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
        {%- else -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image | image_url: width: 750 }}">
        {%- endif -%}
        <source media="(min-width: 768px)" srcset="{{ section.settings.image | image_url: width: 1920 }}">
        <img 
          src="{{ section.settings.image | image_url: width: 1920 }}" 
          alt="{{ section.settings.alt_text | default: section.settings.image.alt | escape }}" 
          class="clickable-banner__img"
          loading="lazy"
          width="{{ section.settings.image.width | default: 1920 }}"
          height="{{ section.settings.image.height | default: 600 }}"
        >
      </picture>
    {%- else -%}
      <div class="clickable-banner__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg clickable-banner__img' }}
      </div>
    {%- endif -%}
  </a>
</div>

{% stylesheet %}
  .clickable-banner {
    width: 100%;
    margin: 0;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }
  .clickable-banner__link {
    display: block;
    width: 100%;
    text-decoration: none;
    line-height: 0;
    cursor: pointer;
  }
  .clickable-banner__picture {
    display: block;
    width: 100%;
    line-height: 0;
  }
  .clickable-banner__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .clickable-banner__placeholder {
    width: 100%;
    background-color: #f3f4f6;
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 16 / 6;
  }
  .clickable-banner__placeholder svg {
    width: 100%;
    height: 100%;
    max-height: 450px;
    fill: #9ca3af;
  }
  @media screen and (max-width: 767px) {
    .clickable-banner__placeholder {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner Clickeable",
  "tag": "section",
  "class": "section-clickable-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de escritorio",
      "info": "Recomendado: 1920x600px o similar formato apaisado."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen de móvil (opcional)",
      "info": "Si no se sube, se usará la de escritorio. Recomendado: 750x1000px o formato vertical."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace del banner",
      "info": "Hace que todo el banner sea clickeable y redirija a esta URL."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (SEO)",
      "info": "Describe la imagen para accesibilidad y SEO."
    },
    {
      "type": "header",
      "content": "Espaciado (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Banner Clickeable"
    }
  ]
}
{% endschema %}
